# Project command policy for Codex.
# Rules apply to commands Codex requests outside the sandbox.

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Do not publish repository changes from this local setup workflow.",
    match = ["git push", "git push origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard local work. Ask the user for an explicit recovery plan instead.",
    match = ["git reset --hard", "git reset --hard HEAD"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Do not delete untracked files from this repository.",
    match = ["git clean -fd", "git clean -xfd"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "System-level commands are outside the scope of this repository setup.",
    match = ["sudo true", "sudo defaults write com.apple.finder AppleShowAllFiles -bool true"],
)

prefix_rule(
    pattern = ["brew"],
    decision = "prompt",
    justification = "Package managers can alter the host machine; require explicit user approval.",
    match = ["brew install git", "brew bundle --file Brewfile"],
)

prefix_rule(
    pattern = ["./install.sh"],
    decision = "prompt",
    justification = "The macOS installer changes the host machine and should run only after explicit user approval.",
    match = ["./install.sh"],
)

prefix_rule(
    pattern = ["defaults", "write"],
    decision = "prompt",
    justification = "macOS defaults changes require explicit user approval.",
    match = ["defaults write com.apple.finder AppleShowAllFiles -bool true"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Committing is local but should happen only after the user confirms the prepared files.",
    match = ["git commit -m setup", "git commit"],
)
