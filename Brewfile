# Core command-line tools
brew "curl"
brew "git"
brew "htop"
brew "mas"
brew "tmux"

# Shell experience
brew "starship"
brew "fzf"

# Fonts: Homebrew Cask fetches the official upstream release.
cask "font-fira-code"

# Applications: casks fetch official vendor artifacts. A manually installed app
# is left alone instead of being adopted or reinstalled by Homebrew.
cask "ghostty" unless File.exist?("/Applications/Ghostty.app") || File.exist?(File.expand_path("~/Applications/Ghostty.app"))
cask "visual-studio-code" unless File.exist?("/Applications/Visual Studio Code.app") || File.exist?(File.expand_path("~/Applications/Visual Studio Code.app"))
cask "google-chrome" unless File.exist?("/Applications/Google Chrome.app") || File.exist?(File.expand_path("~/Applications/Google Chrome.app"))
cask "google-drive" unless File.exist?("/Applications/Google Drive.app") || File.exist?(File.expand_path("~/Applications/Google Drive.app"))
cask "yandex-disk" unless File.exist?("/Applications/Yandex.Disk.app") || File.exist?(File.expand_path("~/Applications/Yandex.Disk.app"))
cask "keepassxc" unless File.exist?("/Applications/KeePassXC.app") || File.exist?(File.expand_path("~/Applications/KeePassXC.app"))
cask "macwhisper" unless File.exist?("/Applications/MacWhisper.app") || File.exist?(File.expand_path("~/Applications/MacWhisper.app"))
cask "raycast" unless File.exist?("/Applications/Raycast.app") || File.exist?(File.expand_path("~/Applications/Raycast.app"))
cask "claude" unless File.exist?("/Applications/Claude.app") || File.exist?(File.expand_path("~/Applications/Claude.app"))
cask "chatgpt" unless File.exist?("/Applications/ChatGPT.app") || File.exist?(File.expand_path("~/Applications/ChatGPT.app"))
cask "utm" unless File.exist?("/Applications/UTM.app") || File.exist?(File.expand_path("~/Applications/UTM.app"))
